# Pazzera web image — Next.js production build + custom server with
# Socket.IO attached to the same HTTP port (no separate socket server
# needed; nginx proxies /socket.io/ over the same origin).
FROM node:20-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    libc6 tini openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Dependencies
FROM base AS deps
COPY pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/storage/package.json packages/storage/
COPY packages/blockchain/package.json packages/blockchain/
COPY packages/queue/package.json packages/queue/
COPY packages/realtime/package.json packages/realtime/
COPY packages/agents/package.json packages/agents/
COPY pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm install --frozen-lockfile

# Build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages ./packages
COPY . .
# Inject .env so static page prerendering (which validates env vars at
# module load) succeeds in the build container. .env is in the build
# context (mounted from /opt/pazzera/.env); COPY it explicitly.
COPY .env .env
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm --filter @pazzera/web build

# Runtime
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV SOCKET_PORT=3000
# pnpm must be on PATH in the runner so tsx + workspace deps resolve.
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate && \
    groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m -s /bin/bash pazzera
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web/server.ts ./apps/web/server.ts
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json
RUN mkdir -p /app/data/agent-stage && \
    chmod 777 /app/data/agent-stage && \
    chmod -R 777 /tmp/pazzera-uploads 2>/dev/null || true
USER pazzera
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
# Custom server boots Next.js HTTP server and attaches Socket.IO to
# the same listener. Browser reaches it via same-origin
# pazzera.com/socket.io/. SOCKET_PORT env unused (port shared with
# Next.js on 3000).
CMD ["pnpm", "exec", "tsx", "apps/web/server.ts"]

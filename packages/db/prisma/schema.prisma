// Pazzera Prisma schema — Phase 2.
//
// Conventions:
//   - Money is stored as decimal strings (USDC has 6 decimals on Arc).
//   - Enums are Postgres ENUMs (see ./enums.sql) declared via raw `Unsupported` columns
//     for cross-version Prisma compatibility, OR via String + check constraints.
//   - Indexes are tuned for: (a) hot playback tick ingestion, (b) payment lookups,
//     (c) catalog browse, (d) analytics rollups.
//   - See docs/PARTITIONING.md for the Streams / PlaybackTick partition strategy.
//
// Phase 2 hardening vs Phase 1 preview:
//   - RoyaltyRecipient: generic role enum + nullable userId/externalWalletAddress + payoutPriority
//   - Song: full lifecycle status enum
//   - Wallet: status enum + frozenAt + compromisedAt + recoveryRequestedAt
//   - Stream: fraudScore + manualReview + fraudSignals JSON + ipAddress + userAgent
//   - PlaybackTick: muted, hidden, looped, deviceFingerprint
//   - New: LedgerEntry (double-entry accounting), DailyMetrics, SongMetrics, ArtistMetrics
//   - ManualReview queue (extends AgentLog)
//   - Discovery Agent queues + events reserved (no implementation yet)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════════════════
//
// We use String columns + Zod-validated application enums rather than
// Prisma native enums because Postgres enum migrations are painful.
// The strings here are the canonical values; the application enforces them.

// UserRole:           listener | artist | admin
// ArtistOnboardStatus: none | pending | approved | rejected
// WalletStatus:       pending_provisioning | active | frozen | compromised | recovery_requested
// SongStatus:         draft | uploaded | under_review | approved | published | rejected | suspended
// RoyaltyRole:        primary_artist | featured_artist | producer | songwriter | label | custom
// PaymentStatus:      pending | manual_review | settled | failed | distributed | refunded
// PayoutStatus:       pending | sent | failed | refunded
// StreamEndReason:    natural | skipped | aborted | flagged | fraud
// CuratorDecision:    approved | rejected | needs_changes | suspended
// AgentName:          curator | fan | split | discovery
// MetricScope:        platform | song | artist
// ManualReviewStatus: pending | approved | rejected | refunded
// LedgerEntryStatus:  pending | settled | failed | reversed

// ════════════════════════════════════════════════════════════════════
// USERS + AUTH
// ════════════════════════════════════════════════════════════════════

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  displayName     String?
  bio             String?
  avatarUrl       String?
  role            String    @default("listener") // see UserRole
  isArtist        Boolean   @default(false)
  onboardStatus   String    @default("none")    // see ArtistOnboardStatus
  onboardedAt     DateTime?
  emailVerifiedAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet             Wallet?
  artistProfile      ArtistProfile?
  songs              Song[]              @relation("ArtistSongs")
  streams            Stream[]
  payments           Payment[]           @relation("PayerPayments")
  recipients         RoyaltyRecipient[]
  payoutEntries      LedgerEntry[]       @relation("LedgerCreditUser")
  otpCodes           OtpCode[]
  sessions           Session[]
  artistMetrics      ArtistMetrics?
  manualReviewsRaised  ManualReview[]    @relation("ReviewSubject")
  manualReviewsDecided ManualReview[]    @relation("ReviewDecider")
  fraudHistory       FraudEvent[]
  deviceFingerprints DeviceFingerprint[]

  @@index([username])
  @@index([email])
  @@index([role, isArtist])
  @@index([createdAt])
}

model ArtistProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  bannerUrl   String?
  socialLinks Json?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ════════════════════════════════════════════════════════════════════
// WALLET
// ════════════════════════════════════════════════════════════════════
//
// Wallet.status drives UX:
//   pending_provisioning → spinner, "Setting up your wallet..."
//   active               → normal
//   frozen               → "Wallet frozen — contact support" (admin action)
//   compromised          → user reported key compromise; payout only mode
//   recovery_requested   → user requested social/email recovery flow
//
// balanceUsdc is the cached value; the source of truth is LedgerEntry.

model Wallet {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              String    @unique

  // ─── Encryption v2 (versioned, rotation-ready) ───
  // Plaintext private key is NEVER stored. The blob is the v2 PHC format
  // (see packages/blockchain/src/wallets/encryption.ts).
  encryptedPrivateKey  String
  encryptionVersion    Int       @default(2)
  keyVersion           Int       @default(1)
  encryptionSalt       String?   // optional per-user salt (Phase 4 uses HKDF salts)
  // Provider metadata
  provider             String    @default("local-dev") // see WalletProvider.name
  providerWalletId     String?   // provider's internal ID (Circle walletId etc.)
  custody              String    @default("user")      // 'user' (UCW) | 'platform' (LocalDev demo)

  status               String    @default("pending_provisioning") // see WalletStatus
  balanceUsdc          String    @default("0")  // cached
  pendingUsdc          String    @default("0")  // in-flight payouts
  // Indexer
  lastIndexedBlock     BigInt?
  indexerCursor        Json?     // { lastBlock, lastAt, gapRanges: [{from,to}] }
  // Lifecycle
  frozenAt             DateTime?
  frozenReason         String?
  compromisedAt        DateTime?
  recoveryRequestedAt  DateTime?
  // x402 spend caps (Option B delegated auth)
  x402DailyCapUsdc     String?   // max nano-payment authorization per day
  x402PerStreamCapUsdc String?   // max per single stream authorization
  x402AuthorizedAt     DateTime? // last time the user granted an x402 scope

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  debitEntries         LedgerEntry[] @relation("LedgerDebitWallet")
  creditEntries        LedgerEntry[] @relation("LedgerCreditWallet")
  transactions         WalletTransaction[]
  recovery             WalletRecovery?
  analytics            WalletAnalytics?

  @@index([address])
  @@index([status])
  @@index([provider])
}

// ════════════════════════════════════════════════════════════════════
// ROYALTY RECIPIENTS (flexible, no hardcoded roles)
// ════════════════════════════════════════════════════════════════════
//
// A recipient is either:
//   - an internal Pazzera user (userId set, externalWalletAddress null), OR
//   - an external wallet owner (userId null, externalWalletAddress set).
//
// role is one of: primary_artist | featured_artist | producer | songwriter | label | custom
// payoutPriority breaks ties when amounts don't split cleanly.
// splitPercentageBps: basis points (10000 = 100%); the sum across all recipients
// for a given song MUST equal 10000 (enforced by application code).

model RoyaltyRecipient {
  id                   String   @id @default(cuid())
  songId               String
  song                 Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  // Exactly one of these is set
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  externalWalletAddress String?
  externalLabel        String?  // e.g. "ACME Records — accounting@acme.com"

  username             String   // display name; for internal users must match User.username
  role                 String   // see RoyaltyRole
  splitPercentageBps   Int      // 10000 = 100%
  payoutPriority       Int      @default(100) // lower = earlier; tie-break for remainder distribution
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([songId, userId, role])                              // prevents duplicate internal recipients
  @@unique([songId, externalWalletAddress, role])               // prevents duplicate external recipients
  @@index([songId, payoutPriority])
  @@index([userId])
  @@index([externalWalletAddress])
}

// ════════════════════════════════════════════════════════════════════
// MUSIC CATALOG
// ════════════════════════════════════════════════════════════════════

model Song {
  id                    String   @id @default(cuid())
  slug                  String   @unique

  // Metadata
  title                 String
  artistId              String
  artist                User     @relation("ArtistSongs", fields: [artistId], references: [id])
  artistName            String
  artistUsername        String
  featuredNames         String[] @default([])
  producerName          String?
  description           String?

  // Media
  coverKey              String
  coverUrl              String
  audioKey              String
  audioUrl              String
  previewKey            String?
  previewUrl            String?
  coverThumbKey         String?
  coverMediumKey        String?
  coverThumbUrl         String?
  coverMediumUrl        String?
  waveformKey           String?
  waveformUrl           String?

  // Audio characteristics
  durationSeconds       Int
  audioBitrateKbps      Int?
  audioSampleRateHz     Int?
  audioChannels         Int?
  audioPeakDb           Float?
  audioCodec            String?
  audioContainer        String?
  audioHash             String?            // SHA-256 binary
  acousticHash          String?            // content-based fingerprint
  audioLufsIntegrated   Float?            // -70 = silence
  audioLufsRange        Float?
  audioTruePeakDb       Float?
  audioSilenceRatio     Float?            // 0..1
  waveformPeaks         Json?            // {min: number[], max: number[]} normalized 0..1

  // Cover art processing
  coverWidthPx          Int?
  coverHeightPx         Int?
  coverIsSquare         Boolean?
  coverAspectRatio      Float?

  // Pricing
  artistPriceUsdc       String   // requested by artist
  publishedPriceUsdc    String?  // set by curator after review

  // Curator evaluation v3 — 7 dimensions × 20 points = 140 raw → normalized 0–100
  //   scoreMetadata:    title/length, artist/featured/producer, description, resolved usernames, cover URL
  //   scoreAudio:       bitrate/sample rate/channels/codec/peak, silence ratio
  //   scoreLoudness:    EBU R128 integrated LUFS, LRA range, true peak (added Phase 7)
  //   scoreArtwork:     min resolution, square-ish aspect ratio (added Phase 7)
  //   scoreMarket:      artist history, recipient count, duration sweet spot
  //   scoreDuplicate:   binary + acoustic fingerprint check (inverted; 20 = unique)
  //   scoreSpam:        description markers, duration extremes, prior flags (inverted; 20 = legit)
  //
  //   decision:         approved | rejected | needs_changes | manual_review (Phase 7)
  //   confidence:       0–100 (Phase 7); higher = stronger signals, fewer weak dimensions
  curatorStatus         String    @default("pending")     // see CuratorDecision
  curatorDecision       String?   @default("approved")    // explicit decision string (Phase 7)
  curatorScoreTotal     Int?                          // 0–100
  curatorScoreMetadata  Int?                          // 0–20
  curatorScoreAudio     Int?                          // 0–20
  curatorScoreSpam      Int?                          // 0–20 (LOW is better; 20 = clearly legitimate)
  curatorScoreDuplicate Int?                         // 0–20 (HIGH = clearly unique)
  curatorScoreMarket    Int?                          // 0–20 (engagement prediction)
  curatorScoreLoudness  Int?                         // 0–20 (Phase 7 — EBU R128 scoring)
  curatorScoreArtwork   Int?                         // 0–20 (Phase 7 — resolution + aspect)
  curatorConfidence     Int?                         // 0–100 (Phase 7)
  curatorReasons        String[]  @default([])
  curatorReviewedAt     DateTime?
  curatorDecisionPayload Json?                       // full CategoryScores snapshot (Phase 7)

  // Lifecycle (see SongStatus)
  //   draft                  → metadata only, no media
  //   uploading              → presigned URL issued, client uploading
  //   processing             → media stored, processing pipeline started
  //   metadata_extracted     → ffprobe + fingerprint done
  //   waveform_generated     → peaks JSON stored
  //   curator_queued         → curator job enqueued
  //   approved               → curator approved, not yet public
  //   published              → live in catalog (isPublic=true)
  //   rejected               → curator rejected; artist may revise
  //   failed_processing      → pipeline error
  status                String    @default("draft")
  publishedAt           DateTime?
  suspendedAt           DateTime?
  suspendedReason       String?
  // Per-step error tracking
  errorStep             String?           // 'metadata' | 'waveform' | 'preview' | 'cover' | 'curator' | 'finalize'
  errorMessage          String?
  errorRetries          Int      @default(0)

  isPublic              Boolean   @default(false)
  playCount             Int       @default(0)
  uniqueListenerCount   Int       @default(0)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  recipients            RoyaltyRecipient[]
  streams               Stream[]
  payments              Payment[]
  songMetrics           SongMetrics?
  manualReviews         ManualReview[]

  @@index([artistId])
  @@index([status, isPublic, publishedAt(sort: Desc)])
  @@index([audioHash])
  @@index([isPublic, playCount(sort: Desc)])     // trending
  @@index([createdAt(sort: Desc)])
}

// ════════════════════════════════════════════════════════════════════
// STREAMING
// ════════════════════════════════════════════════════════════════════
//
// See docs/PARTITIONING.md — Stream and PlaybackTick are partitioned monthly by startedAt.
// For the Phase 2 Prisma model we declare them as regular tables; the migration
// includes ALTER TABLE ... ATTACH PARTITION statements.

model Stream {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId          String
  song            Song      @relation(fields: [songId], references: [id])

  startedAt       DateTime  @default(now())
  endReason       String?   // see StreamEndReason
  totalActiveMs   Int       @default(0)

  // Anti-abuse flags
  charged         Boolean   @default(false)
  chargedAt       DateTime?
  flaggedAbuse    Boolean   @default(false)
  fraudScore      Int       @default(0)        // 0–100, computed by Fan Agent
  fraudSignals    Json?                       // breakdown of contributing signals
  manualReview    Boolean   @default(false)   // true → goes to manual review queue
  manualReviewReason String?

  // Phase 7 — Fan Agent v2 stream classification
  classification   String    @default("valid_stream") // valid_stream | partial_stream | suspicious_stream | fraudulent_stream
  // Telemetry summary (snapshot of PlaybackTick aggregates)
  listenDurationSec Int?     // seconds the page was visible + audio playing + not muted
  mutedDurationSec  Int?
  hiddenDurationSec Int?
  paymentTriggered  Boolean  @default(false)
  paymentTriggerSec Int?     // monotonicMs/1000 when payment was charged
  // Fan decision log id (FK to AgentDecisionLog)
  fanDecisionLogId String?

  // Connection context
  ipAddress       String?
  userAgent       String?
  deviceFingerprintId String?

  // Phase 8 — realtime stream lifecycle
  endedAt         DateTime?
  endedReason     String?   // 'natural' | 'skipped' | 'paused' | 'timeout' | 'flagged' | 'payment_failed'
  effectiveDurationMs Int @default(0)   // server-tracked, excludes muted/hidden abuse
  loopCount       Int       @default(0)
  seekCount       Int       @default(0)
  maxPlaybackRate Float?    // peak observed rate
  thresholdCrossed Boolean @default(false)
  lastClientTimestampMs BigInt?
  // Session token so client reconnect can resume the same stream
  sessionToken    String?   @unique

  ticks           PlaybackTick[]
  payment         Payment?
  manualReviewRow ManualReview?
  nonces          PaymentNonce[]

  // Phase 8 admin observability — linked events

  @@index([userId, startedAt(sort: Desc)])
  @@index([songId, startedAt(sort: Desc)])
  @@index([fraudScore(sort: Desc)])                          // admin dashboards
  @@index([manualReview, startedAt(sort: Desc)])
  @@index([charged, startedAt])
  @@index([sessionToken])
  @@index([endedAt])
}

model PlaybackTick {
  id                  String   @id @default(cuid())
  streamId            String
  stream              Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)

  monotonicMs         BigInt
  positionSec         Float

  // Behavioral signals — Fan Agent uses these for fraud scoring
  wasPause            Boolean  @default(false)
  wasSeek             Boolean  @default(false)
  seekFromSec         Float?
  seekToSec           Float?
  wasMuted            Boolean  @default(false)
  wasHidden           Boolean  @default(false)  // tab background / window minimized
  wasLooped           Boolean  @default(false)  // client re-entered threshold region
  audioElementVolume  Float?                   // 0.0–1.0

  createdAt           DateTime @default(now())

  @@index([streamId, monotonicMs])
  @@index([createdAt])
}

model DeviceFingerprint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   @unique
  label       String?  // "Chrome on macOS", etc.
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
}

model FraudEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // loop_play | muted_play | hidden_play | device_repeat | ip_repeat | farm_pattern
  severity  Int      // 0–100, contributes to Stream.fraudScore
  meta      Json?
  streamId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// ════════════════════════════════════════════════════════════════════
// WALLET TRANSACTION LOG + RECOVERY + ANALYTICS
// ════════════════════════════════════════════════════════════════════

// Unified on-chain + off-chain wallet transaction log.
//   Type:    deposit | withdraw | stream_payment | royalty_payout | refund | adjustment | x402_settlement
//   Status:  pending → signed → submitted → confirmed
//                     └──── failed ←──┘
//                              └→ reversed

// Phase 8 — Cryptographic nonces used to defeat double-spend/replay attacks on
// the x402 payment_due -> payment_settled round-trip. A nonce is bound to a
// (streamId, userId) pair and is single-use. Postgres is the source of truth
// (Redis is the hot cache). TTL 600s via @pazzera/realtime/nonce-store.
model PaymentNonce {
  id          String    @id @default(cuid())
  nonce       String    @unique
  streamId    String
  stream      Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId      String
  amountUsdc  String
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([streamId])
  @@index([userId, expiresAt])
}

// Phase 8 — Append-only log of payment_due / payment_settled events emitted
// over Socket.IO. Powers the admin streaming-health dashboard's per-minute
// counters, decoupling observability from socket transport state.
model PaymentEvent {
  id          String   @id @default(cuid())
  kind        String   // 'payment_due' | 'payment_settled' | 'stream_start' | 'stream_end' | 'socket_disconnect'
  streamId    String?
  paymentId   String?
  songId      String?
  userId      String?
  amountUsdc  String?
  severity    Int      @default(0) // 0=info, 25=warn, 50=critical
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt(sort: Desc)])
  @@index([streamId])
  @@index([paymentId])
  @@index([severity, createdAt(sort: Desc)])
}

model WalletTransaction {
  id                  String   @id @default(cuid())
  walletId            String
  wallet              Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type                String
  direction           String   // 'debit' | 'credit'
  amountUsdc          String
  amountBaseUnits     String
  status              String   @default("pending")
  txHash              String?
  blockNumber         BigInt?
  counterpartyAddress String?
  memo                String?
  meta                Json?
  // Lifecycle timestamps
  signedAt            DateTime?
  submittedAt         DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?
  reversedAt          DateTime?
  // Cross-links
  streamId            String?
  paymentId           String?
  payoutId            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([walletId, createdAt(sort: Desc)])
  @@index([status])
  @@index([txHash])
  @@index([type, createdAt(sort: Desc)])
}

// Wallet recovery flow
model WalletRecovery {
  id                 String   @id @default(cuid())
  walletId           String   @unique
  wallet             Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId             String
  state              String   @default("recovery_requested") // recovery_requested | recovery_verified | recovery_completed
  reason             String?  // lost_key | compromised | device_lost
  challenge          String?  // short-lived token sent via email
  challengeExpiresAt DateTime?
  attempts           Int      @default(0)
  newEncryptedSecret String?  // populated on completion
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, state])
  @@index([challengeExpiresAt])
}

// Per-wallet analytics — populated by the indexer and payment workers.
model WalletAnalytics {
  id                          String   @id @default(cuid())
  walletId                    String   @unique
  wallet                      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  totalDepositsBaseUnits      String   @default("0")
  totalSpendBaseUnits         String   @default("0")
  totalEarningsBaseUnits      String   @default("0")
  streamCount                 Int      @default(0)
  avgSpendPerStreamBaseUnits  String   @default("0")

  // 0–100; 100 = healthy. Computed from activity + caps + freshness.
  healthScore                 Int      @default(100)
  lastIndexedAt               DateTime?
  lastDepositAt               DateTime?
  lastSpendAt                 DateTime?
  lastEarningAt               DateTime?

  updatedAt                   DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════
// PAYMENTS + PAYOUTS + LEDGER
// ════════════════════════════════════════════════════════════════════

model Payment {
  id                     String   @id @default(cuid())
  streamId               String   @unique
  stream                 Stream   @relation(fields: [streamId], references: [id])
  songId                 String
  song                   Song     @relation(fields: [songId], references: [id])
  payerUserId            String
  payer                  User     @relation("PayerPayments", fields: [payerUserId], references: [id])

  amountUsdc             String
  amountBaseUnits        String
  status                 String   @default("pending") // see PaymentStatus

  // On-chain settlement
  txHash                 String?
  facilitatorTransferId  String?
  settledAt              DateTime?
  distributedAt          DateTime?
  refundedAt             DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  payouts                Payout[]
  ledgerEntries          LedgerEntry[]

  @@index([payerUserId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([songId, createdAt])
  @@index([txHash])
  @@index([facilitatorTransferId])
}

model Payout {
  id                String   @id @default(cuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  recipientUserId   String?
  recipientUsername String
  recipientWalletId String?   // set when the recipient has a Pazzera Wallet; null for external recipients
  recipientAddress  String
  recipientRole     String   // mirrors RoyaltyRecipient.role at payout time
  splitPercentageBps Int     // mirrors RoyaltyRecipient.splitPercentageBps

  // Phase 7: also track kind for fraud analyst queries (e.g. 'royalty_payout' | 'withdraw' | 'refund')
  kind              String   @default("royalty_payout")

  amountUsdc        String
  amountBaseUnits   String
  txHash            String?
  status            String   @default("pending") // see PayoutStatus
  error             String?
  createdAt         DateTime @default(now())
  confirmedAt       DateTime?

  ledgerEntry       LedgerEntry?

  @@index([paymentId])
  @@index([recipientUsername])
  @@index([recipientUserId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────
// LedgerEntry — internal double-entry accounting.
//
// Every money movement creates:
//   - 1 debit row (fromWallet = source)
//   - 1 credit row(s) (toWallet = recipient(s))
//
// grossAmount == sum(splitAmount) for any paymentId.
// chainTxHash links to the on-chain transfer (if any).
// status mirrors the on-chain lifecycle so finance reports can be generated
// without scanning the chain.
// ────────────────────────────────────────────────────────────────────

model LedgerEntry {
  id                 String   @id @default(cuid())
  paymentId          String?
  payment            Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payoutId           String?  @unique
  payout             Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  // Wallet pointers
  fromWalletId       String?
  fromWallet         Wallet?  @relation("LedgerDebitWallet", fields: [fromWalletId], references: [id])
  fromAddress        String   // denormalized for ledger stability if wallet is rotated
  fromUserId         String?  // for listener-side accounting

  toWalletId         String?
  toWallet           Wallet?  @relation("LedgerCreditWallet", fields: [toWalletId], references: [id])
  toAddress          String   // denormalized
  toUserId           String?
  toUser             User?    @relation("LedgerCreditUser", fields: [toUserId], references: [id], onDelete: SetNull)

  // Amounts
  grossAmountBaseUnits String                       // original payment gross
  splitAmountBaseUnits String                       // this entry's share
  currency             String   @default("USDC")

  direction          String   // debit | credit
  kind               String   // stream_payment | royalty_payout | deposit | withdraw | refund | adjustment

  status             String   @default("pending") // see LedgerEntryStatus
  chainTxHash        String?
  chainBlockNumber   BigInt?
  chainConfirmedAt   DateTime?

  memo               String?
  meta               Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([paymentId])
  @@index([payoutId])
  @@index([fromWalletId, createdAt(sort: Desc)])
  @@index([toWalletId, createdAt(sort: Desc)])
  @@index([toUserId, createdAt(sort: Desc)])
  @@index([fromAddress, createdAt(sort: Desc)])
  @@index([toAddress, createdAt(sort: Desc)])
  @@index([status])
  @@index([chainTxHash])
  @@index([createdAt(sort: Desc)])
}

// ════════════════════════════════════════════════════════════════════
// ANALYTICS
// ════════════════════════════════════════════════════════════════════
//
// Materialized by the analytics rollup worker (cron: every 5 min for
// rolling window, daily snapshot for DailyMetrics). All amounts in USDC
// base units (BigInt as string) to avoid float drift.

model DailyMetrics {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date

  // Platform-wide
  dau             Int      @default(0)
  newUsers        Int      @default(0)
  totalStreams    Int      @default(0)
  uniqueListeners Int      @default(0)
  uniqueArtists   Int      @default(0)

  revenueUsdc           String @default("0")
  revenueBaseUnits      String @default("0")
  payoutsUsdc           String @default("0")
  payoutsBaseUnits      String @default("0")
  netPlatformFeeUsdc    String @default("0")

  avgStreamDurationSec  Float  @default(0)
  flaggedStreams        Int    @default(0)
  manualReviewCount     Int    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date(sort: Desc)])
}

model SongMetrics {
  id                  String   @id @default(cuid())
  songId              String   @unique
  song                Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  streamCount         Int      @default(0)
  uniqueListenerCount Int      @default(0)
  completionRate      Float    @default(0)         // % of streams reaching threshold
  totalRevenueUsdc    String   @default("0")
  totalRevenueBaseUnits String @default("0")

  avgListenDurationSec Float   @default(0)
  lastStreamAt        DateTime?

  // Trending (rolling 7d)
  streamsLast7d       Int      @default(0)
  revenueLast7dUsdc   String   @default("0")

  updatedAt           DateTime @updatedAt
}

model ArtistMetrics {
  id                    String   @id @default(cuid())
  artistId              String   @unique
  artist                User     @relation(fields: [artistId], references: [id], onDelete: Cascade)

  songCount             Int      @default(0)
  publishedSongCount    Int      @default(0)

  totalEarningsUsdc     String   @default("0")
  totalEarningsBaseUnits String  @default("0")
  monthlyEarningsUsdc   String   @default("0")
  activeListeners30d    Int      @default(0)

  streamsLast30d        Int      @default(0)
  uniqueListeners30d    Int      @default(0)

  firstStreamAt         DateTime?
  lastStreamAt          DateTime?

  updatedAt             DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════════
// AGENT LOGS + MANUAL REVIEW
// ════════════════════════════════════════════════════════════════════

model AgentLog {
  id          String   @id @default(cuid())
  agent       String   // see AgentName: curator | fan | split | discovery
  subjectType String?  // song | stream | payment | user
  subjectId   String?
  songId      String?
  streamId    String?
  paymentId   String?

  decision    String
  reason      String?
  // Full structured breakdown (curator scores, fan fraud signals, etc.)
  scoreBreakdown Json?
  payloadJson    Json?

  createdAt   DateTime @default(now())

  @@index([agent, createdAt(sort: Desc)])
  @@index([songId])
  @@index([streamId])
  @@index([paymentId])
  @@index([decision, createdAt])
}

// Manual review queue — payments flagged by Fan Agent fraud scoring.
// Admin views this in the admin dashboard.
model ManualReview {
  id             String   @id @default(cuid())
  streamId       String   @unique
  stream         Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  songId         String
  song           Song     @relation(fields: [songId], references: [id])
  subjectUserId  String
  subject        User     @relation("ReviewSubject", fields: [subjectUserId], references: [id])
  decidedById    String?
  decidedBy      User?    @relation("ReviewDecider", fields: [decidedById], references: [id])

  fraudScore     Int
  fraudSignals   Json
  status         String   @default("pending") // see ManualReviewStatus
  decisionReason String?
  createdAt      DateTime @default(now())
  decidedAt      DateTime?

  @@index([status, createdAt])
  @@index([fraudScore(sort: Desc)])
}

// ════════════════════════════════════════════════════════════════════
// PHASE 7: AGENT DECISION LOGS + HEALTH + FRAUD ALERTS
// ════════════════════════════════════════════════════════════════════
//
// AgentDecisionLog is the canonical audit record for every AI decision.
// Every agent worker MUST persist here in addition to AgentLog.
// - inputHash: SHA-256(canonical input JSON) — lets us dedupe + replay.
// - inputs / outputs: full structured snapshots so judges can inspect
//   a decision without re-running anything.
// - confidence: 0–100 (agent-specific).
// - latencyMs: wall clock from job start to decision.
// - reasons[]: human-readable bullets for the AI Explainability UI.
//
// AgentHealthMetrics powers the Agent Status cards on the admin
// dashboard. Updated by the rollup worker every minute from BullMQ.
//
// FraudAlert is produced by the Fraud Sentinel agent and is the
// canonical storage for fraud detections. High severity auto-freezes
// related wallet payouts (handled in the worker, NOT via trigger).
//
// AgentName enum: curator | fan | split | discovery | fraud_sentinel
// FraudSeverity:  low | medium | high | critical
// FraudEntityType: user | wallet | song | payment_cluster | ip_cluster
// FraudAlertStatus: open | under_review | resolved | false_positive | escalated
// AgentHealthScope: live | minute | hour | day

model AgentDecisionLog {
  id           String   @id @default(cuid())

  // Which agent made this decision
  agent        String   // see AgentName

  // What it was deciding on
  subjectType  String   // song | stream | payment | user | wallet | playlist | session
  subjectId    String

  // Optional cross-links
  songId       String?
  streamId     String?
  paymentId    String?
  userId       String?

  // Decision payload
  decision     String   // 'approved' | 'rejected' | 'needs_changes' | 'manual_review' | 'charged' | 'flagged' | 'frozen' | ...
  confidence   Int      @default(50)   // 0–100

  // Reasons (human-readable, what the AI Explainability UI shows)
  reasons      String[] @default([])

  // Full breakdown (curator categoryScores, fan signals, fraud reasons with weights)
  categoryScores Json?

  // Raw inputs (truncated for storage if huge — large blobs go to scoreBreakdown above)
  inputs       Json?

  // Performance
  latencyMs    Int?
  retries      Int      @default(0)

  // Determinism: inputHash so we can replay + dedupe
  inputHash    String

  // Soft failure (decision was made but post-decision steps failed)
  warnings     String[] @default([])

  // Audit
  version      String   @default("v3") // bumps when the agent's scoring model changes
  producedBy   String   @default("pazzera-agent-runtime")
  createdAt    DateTime @default(now())

  @@index([agent, createdAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@index([songId])
  @@index([streamId])
  @@index([paymentId])
  @@index([userId])
  @@index([decision, createdAt(sort: Desc)])
  @@index([inputHash])
  @@unique([agent, inputHash])  // deterministic + idempotent
}

model AgentHealthMetrics {
  id           String   @id @default(cuid())
  agent        String
  scope        String   @default("minute") // see AgentHealthScope
  bucketStart  DateTime
  bucketEnd    DateTime

  // Throughput
  jobsProcessed Int     @default(0)
  jobsFailed    Int     @default(0)
  jobsRetried   Int     @default(0)

  // Latency
  p50LatencyMs Int      @default(0)
  p95LatencyMs Int      @default(0)
  p99LatencyMs Int      @default(0)

  // Snapshot of running state at bucketEnd
  queueDepth   Int      @default(0)
  activeJobs   Int      @default(0)
  lastExecutionAt DateTime?

  // Health status (computed from success rate)
  status       String   @default("healthy") // healthy | degraded | unhealthy | unknown
  successRate  Float    @default(1.0) // 0..1

  createdAt    DateTime @default(now())

  @@unique([agent, scope, bucketStart])
  @@index([agent, scope, bucketStart(sort: Desc)])
  @@index([status])
}

model FraudAlert {
  id           String   @id @default(cuid())
  severity     String   // see FraudSeverity
  entityType   String   // see FraudEntityType
  entityId     String   // ID of the user / wallet / song / payment cluster

  // SubjectType / SubjectId links
  subjectUserId String?
  subjectSongId String?
  subjectWalletId String?

  // Reasons + score breakdown
  score        Int      // 0–100
  reasons      String[] @default([])
  metricBreakdown Json? // weighted signals: { streamFarmScore: 80, circularPaymentScore: 70, ... }

  // Status
  status       String   @default("open") // see FraudAlertStatus
  decidedById  String?
  decisionNote String?
  decidedAt    DateTime?

  // Auto-action flag (Phase 7: high severity auto-freezes payouts)
  autoActioned Boolean  @default(false)
  autoAction   String?  // 'wallet_frozen' | 'payouts_paused' | 'account_locked'

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([severity, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([status, createdAt(sort: Desc)])
  @@index([subjectUserId])
}

// ════════════════════════════════════════════════════════════════════
// AUTH SESSIONS + OTP
// ════════════════════════════════════════════════════════════════════

model OtpCode {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  // Phase 3: Argon2id hash of the OTP code; salt is part of the encoded string.
  // Plaintext OTP is NEVER persisted.
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptsUsed Int       @default(0)
  maxAttempts  Int       @default(5)
  // Purpose: 'sign_in' (default) | 'reset_password' | 'wallet_recovery' | 'artist_upgrade'
  purpose      String    @default("sign_in")
  // IP and UA captured at request time for risk scoring
  requestIp    String?
  requestUserAgent String?
  requestIpHash    String?
  // Marked invalid on success
  invalidated  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([purpose, email, createdAt])
}

model Session {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken          String    // double-submit cookie value
  // Hashed — raw token never stored. Cookie carries the raw token, server hashes + looks up.
  sessionTokenHash   String    @unique
  deviceFingerprint  String?
  ipHash             String?   // SHA-256(ip) — never store raw IP in sessions
  userAgent          String?
  // Lifecycle
  issuedAt           DateTime  @default(now())
  expiresAt          DateTime  // 30 days from issue
  lastSeenAt         DateTime  @default(now())
  // 14-day inactivity timeout enforced on each request
  inactivityExpiresAt DateTime
  revokedAt          DateTime?
  revokedReason      String?   // logout | admin_revoke | password_reset | suspicion

  @@index([userId])
  @@index([expiresAt])
  @@index([inactivityExpiresAt])
  @@index([sessionTokenHash])
}

// ══════════════════════════════════════════════════════════════════
// UPLOAD SESSIONS (Phase 6)
// ══════════════════════════════════════════════════════════════════

// A presigned-upload session. Created when the client requests upload
// permission, completed when the client calls finalize. Stores the
// expected MIME + size, the storage key, the issued ticket.
//
// State:
//   pending   — ticket issued, client hasn't uploaded yet
//   uploaded  — client has called finalize, pipeline started
//   failed    — ticket expired or validation failed
model UploadSession {
  id                  String   @id @default(cuid())
  userId              String
  songId              String
  kind                String   // 'audio' | 'cover'
  storageKey          String
  presignedUrl        String
  expiresAt           DateTime
  // Expected metadata
  expectedMime        String
  expectedSizeBytes   Int
  expectedExt         String
  // Resulting object info
  uploadedBytes       Int?
  uploadedMime        String?
  state               String   @default("pending")
  // Lifecycle
  createdAt           DateTime @default(now())
  finalizedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?

  @@index([userId, state])
  @@index([songId, kind])
  @@index([expiresAt])
}

// AuthEvent — anti-abuse log. Drives AuthRiskScore.
model AuthEvent {
  id          String   @id @default(cuid())
  userId      String?
  email       String?
  // Type: otp_requested | otp_delivered | otp_failed | otp_verified |
  //       otp_rate_limited | disposable_email_blocked |
  //       repeated_otp_requests | multiple_emails_same_ip |
  //       otp_brute_force | session_created | session_revoked | cooldown_applied
  type        String
  // Severity 0–100; aggregated to AuthRiskScore per IP/email.
  severity    Int      @default(0)
  ipHash      String?
  userAgent   String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([email, type, createdAt(sort: Desc)])
  @@index([ipHash, type, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}
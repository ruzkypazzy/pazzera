{
  "name": "@pazzera/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/demo-seed.ts",
    "seed:agent-demo": "tsx prisma/agent-demo-seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@pazzera/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.15.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
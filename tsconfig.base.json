{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "composite": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@pazzera/core": ["./packages/core/src/index.ts"],
      "@pazzera/core/*": ["./packages/core/src/*"],
      "@pazzera/db": ["./packages/db/src/index.ts"],
      "@pazzera/db/*": ["./packages/db/src/*"],
      "@pazzera/storage": ["./packages/storage/src/index.ts"],
      "@pazzera/storage/*": ["./packages/storage/src/*"],
      "@pazzera/blockchain": ["./packages/blockchain/src/index.ts"],
      "@pazzera/blockchain/*": ["./packages/blockchain/src/*"],
      "@pazzera/agents": ["./packages/agents/src/index.ts"],
      "@pazzera/agents/*": ["./packages/agents/src/*"],
      "@pazzera/queue": ["./packages/queue/src/index.ts"],
      "@pazzera/queue/*": ["./packages/queue/src/*"],
      "@pazzera/realtime": ["./packages/realtime/src/index.ts"],
      "@pazzera/realtime/*": ["./packages/realtime/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
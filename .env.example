# ─────────────────────────────────────────────────────────────────────
# Pazzera .env (PHASE 10 production baseline)
# Copy to `.env` and fill in the values marked CHANGE-ME.
# Server boots only when every required key validates.
# ─────────────────────────────────────────────────────────────────────

# --- App ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
SOCKET_PORT=3001
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# --- DB / cache ---------------------------------------------------------
DATABASE_URL=postgresql://pazzera:pazzera@localhost:5432/pazzera
REDIS_URL=redis://localhost:6379

# --- Sessions -----------------------------------------------------------
SESSION_COOKIE_NAME=pazzera_sess
SESSION_TTL_SECONDS=2592000
COOKIE_SECRET=change-me-32-bytes-min-aaaaaaaaaaaaaaaaaaaa
CSRF_SECRET=change-me-32-bytes-min-bbbbbbbbbbbbbbbbbbbbbbbb

# --- OTP / email --------------------------------------------------------
RESEND_API_KEY=re_change-me
RESEND_FROM_EMAIL=Pazzera <noreply@pazzera.test>
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_15MIN=20

# --- Wallet ------------------------------------------------------------
ENCRYPTION_KEY=7f3a9b2e8c1d4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a
WALLET_MASTER_KEY=7f3a9b2e8c1d4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a
PAZZERA_WALLET_PROVIDER=local-dev
WALLET_DAILY_WITHDRAW_CAP_USDC=1000
WALLET_WITHDRAW_COOLDOWN_SECONDS=60
WALLET_RECOVERY_COOLDOWN_HOURS=24
WALLET_X402_DAILY_CAP_USDC=5
WALLET_X402_PER_STREAM_CAP_USDC=0.01

# --- Storage ------------------------------------------------------------
STORAGE_PROVIDER=local
# When STORAGE_PROVIDER=r2:
R2_ENDPOINT=https://CHANGE-ME.r2.cloudflarestorage.com
R2_BUCKET=pazzera-dev
R2_ACCESS_KEY_ID=CHANGE-ME
R2_SECRET_ACCESS_KEY=CHANGE-ME
R2_PUBLIC_BASE_URL=http://localhost:3000/static

# --- Arc ----------------------------------------------------------------
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# --- Circle -------------------------------------------------------------
CIRCLE_API_KEY=TEST_API_KEY:CHANGE-ME
CIRCLE_APP_ID=CHANGE-ME-app-id
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_ENTITY_SECRET=CHANGE-ME
CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
CIRCLE_WALLET_SET_ID=CHANGE-ME
CIRCLE_WEBHOOK_SECRET=change-me-webhook-secret

# --- Agent thresholds ---------------------------------------------------
CURATOR_PRICE_MIN_USDC=0.001
CURATOR_PRICE_MAX_USDC=0.005
FAN_AGENT_DURATION_THRESHOLD_PCT=25
SPLIT_DEFAULT_ARTIST_PCT=70
SPLIT_DEFAULT_FEATURED_PCT=20
SPLIT_DEFAULT_PRODUCER_PCT=10

# --- Indexer ------------------------------------------------------------
INDEXER_BATCH_SIZE=500
INDEXER_INTERVAL_SECONDS=15

# --- Admin / Demo -------------------------------------------------------
ADMIN_EMAILS=
DEMO_MODE=false

# ⚠️  Production MUST set PAZZERA_TEST_API_ENABLED to 'false' or omit.
#     Setting it to 'true' exposes /api/auth/test-otp and
#     /api/realtime/test-skip — do not enable in production.
PAZZERA_TEST_API_ENABLED=true
